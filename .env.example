# Copy to .env and fill in. Never commit .env — it is gitignored.
# Names only here; real values live in Replit Secrets or the host's
# environment settings.

# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Use the pooled URL where the provider offers
# one, and keep ?sslmode=require for any managed host.
DATABASE_URL=

# The origin people actually load in a browser, e.g. https://jamvi.co.ke
# Invitation emails refuse to send without it rather than guessing an origin
# from request headers, which a proxy can forge.
APP_URL=

# ─── Server ──────────────────────────────────────────────────────────────────

# Set by the host in production. Defaults suit local development.
PORT=
NODE_ENV=
LOG_LEVEL=

# ─── Authentication ──────────────────────────────────────────────────────────

# OIDC issuer. Defaults to https://replit.com/oidc, which only works inside
# Replit. Set it to https://accounts.google.com to use Google instead.
ISSUER_URL=

# Replit Auth uses the Repl's own id as the OAuth client id. Provided
# automatically inside Replit; unset anywhere else.
REPL_ID=

# ─── Email ───────────────────────────────────────────────────────────────────

# Display names on outgoing mail, e.g. "Jamvi <info@example.co.ke>"
INVITATION_FROM_EMAIL=
DIGEST_FROM_EMAIL=

# ─── Web build ───────────────────────────────────────────────────────────────

# Sub-path the app is served under. Defaults to /
BASE_PATH=

# ─── Mobile (Expo) ───────────────────────────────────────────────────────────

# Host the mobile app calls for the API, without a scheme.
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_REPL_ID=
METRO_PORT=

# ─── Provided by Replit, do not set by hand ──────────────────────────────────

# REPLIT_DEV_DOMAIN
# REPLIT_INTERNAL_APP_DOMAIN

# ─── Arriving with the off-Replit work, not yet read by main ─────────────────

# GOOGLE_CLIENT_ID       OAuth client from Google Cloud Console
# GOOGLE_CLIENT_SECRET   its secret
# APP_ORIGIN             pins the OAuth callback and cookie to the origin the
#                        user loaded, since the provider redirects the browser
#                        straight to the callback rather than back through the
#                        proxy that fronts /api
# RESEND_API_KEY         replaces the Replit connector for email
# CORS_ORIGINS           comma-separated allowlist; falls back to APP_ORIGIN
