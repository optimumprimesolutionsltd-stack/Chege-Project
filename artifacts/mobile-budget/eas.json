{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_DOMAIN": "jamvi.co.ke"
        }
      }
    },
    "website": {
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_DOMAIN": "jamvi.co.ke",
          "JAMVI_NO_SMS": "1"
        }
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_DOMAIN": "jamvi.co.ke"
        }
      }
    },
    "play": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_DOMAIN": "jamvi.co.ke",
          "JAMVI_PLAY_STORE": "1"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
