# pnpm 11 fails an install outright when a dependency's build script is skipped.
# esbuild is already listed in onlyBuiltDependencies, but it is still reported
# as ignored on Linux, which stopped the first Render build dead. Restoring the
# previous warn-instead-of-fail behaviour keeps CI unblocked; esbuild resolves
# its platform binary from @esbuild/linux-x64, which pnpm-workspace.yaml
# deliberately does not strip.
strict-dep-builds=false
